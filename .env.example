# API
POCKET_ENVIRONMENT=development
POCKET_DATABASE_URL=sqlite:///./pocket-engineer.db
POCKET_CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081,http://127.0.0.1:19006
POCKET_DEMO_ENABLED=true
POCKET_WORKER_ENABLED=true
POCKET_AGENT_PROVIDER=demo
POCKET_AIDER_MODEL=openai/gpt-5
POCKET_COMMAND_TIMEOUT_SECONDS=180
POCKET_ENGINEER_NAME=Alex
POCKET_ENGINEER_TITLE=Senior Engineer
POCKET_SANDBOX_MODE=local
POCKET_GITHUB_WEBHOOK_SECRET=
POCKET_ALERT_WEBHOOK_TOKEN=

# Authentication. Keep disabled locally. Use supabase in a deployed private alpha.
POCKET_AUTH_MODE=disabled
POCKET_AUTH_ALLOWED_EMAILS=
POCKET_SUPABASE_URL=

# GitHub App. The private key may be PEM text or an absolute file path.
POCKET_GITHUB_APP_SLUG=
POCKET_GITHUB_APP_ID=
POCKET_GITHUB_PRIVATE_KEY=
# Local-only alternative to GitHub App installation tokens.
POCKET_GITHUB_TOKEN=

# Realtime engineer calls. This key stays on the API server; clients receive a short-lived secret.
POCKET_OPENAI_API_KEY=
POCKET_REALTIME_MODEL=gpt-realtime-2.1
POCKET_REALTIME_VOICE=marin

# Expo. For a physical phone, replace localhost with the computer's LAN address.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
